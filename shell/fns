genssh () {
  ssh-keygen -t ed25519 -a 500 -f "$HOME/.ssh/$1" -C "$2"
}

# wtype-based universal cut/copy/paste
univ-cut () {
  wtype -M ctrl -P x -p x -m shift
}
#
univ-copy () {
  wtype -M ctrl -P Insert -p Insert -m ctrl
}
#
univ-paste () {
  wtype -M shift -P Insert -p Insert -m shift
}

